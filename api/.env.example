APP_NAME="Nexa POS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=nexa
DB_USERNAME=nexa
DB_PASSWORD=nexa

SESSION_DRIVER=array
QUEUE_CONNECTION=database
CACHE_STORE=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6380

MAIL_MAILER=log

# Origines autorisées à appeler l'API (la caisse, l'admin). Jamais de joker.
CORS_ALLOWED_ORIGINS=http://localhost:5174
